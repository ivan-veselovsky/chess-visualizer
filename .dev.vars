# What `wrangler dev` reads, and a deployment does not: a log is kept where
# somebody is watching. See worker/log.ts.
GAME_LOG=on
# And the registry open to the tests' questions — its state, a policy of
# their own, a sweep at a time they name — and a line allowed to name a
# registry of a test's own. Never on a deployment: see worker/index.ts.
KEEPING_TEST=on
# The admin's token for `wrangler dev`: what /admin/api/health asks for, and what
# the tests send. A deployment has its own, as a secret —
# `npx wrangler secret put ADMIN_TOKEN` — and without one has no admin routes.
ADMIN_TOKEN=dev-admin-token
